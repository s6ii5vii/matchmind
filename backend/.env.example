# OPTIONAL: AI models for the Tactics and Narrator agents. The demo works without any of these.

# Microsoft Foundry / Azure OpenAI deployment
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
AZURE_OPENAI_API_KEY=YOUR_SECRET_API_KEY

# Nebius Token Factory (OpenAI-compatible)
NEBIUS_API_KEY=YOUR_SECRET_API_KEY
NEBIUS_MODEL=openai/gpt-oss-120b

# If both are configured, Foundry wins unless you set this:
# MATCHMIND_PROVIDER=nebius
